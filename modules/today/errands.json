[
  { "id": "pick-job", "title": "Pick a job at the Job Centre", "module": "jobs", "building": "job", "priority": 0, "alone": true,
    "when": [{ "fact": "jobs.hasJob", "op": "==", "value": false }],
    "done": { "facts": [{ "fact": "jobs.hasJob", "op": "==", "value": true }] }, "reward_cents": 200, "energy": 1 },

  { "id": "pay-bills", "title": "Pay the bills that are due", "module": "bills", "building": "bills", "priority": 1,
    "when": [{ "fact": "bills.dueCount", "op": ">", "value": 0 }, { "fact": "bills.autopay", "op": "==", "value": false }],
    "done": { "event": "module.bills.paid" }, "reward_cents": 100, "energy": 1 },
  { "id": "clear-overdue", "title": "Clear your overdue bills before more late fees", "module": "bills", "building": "bills", "priority": 1,
    "when": [{ "fact": "bills.overdueCount", "op": ">", "value": 0 }],
    "done": { "facts": [{ "fact": "bills.overdueCount", "op": "==", "value": 0 }] }, "reward_cents": 100, "energy": 1 },
  { "id": "card-minimum", "title": "Make at least the minimum card payment", "module": "credit", "building": "credit", "priority": 1,
    "when": [{ "fact": "credit.minimumDueCents", "op": ">", "value": 0 }],
    "done": { "facts": [{ "fact": "credit.minimumDueCents", "op": "==", "value": 0 }] }, "reward_cents": 100, "energy": 1 },
  { "id": "autopay-on", "title": "Turn on bill autopay so nothing is missed", "module": "bills", "building": "bills", "priority": 2,
    "when": [{ "fact": "bills.autopay", "op": "==", "value": false }, { "fact": "jobs.hasJob", "op": "==", "value": true }],
    "done": { "facts": [{ "fact": "bills.autopay", "op": "==", "value": true }] }, "reward_cents": 100, "energy": 1 },
  { "id": "apply-promotion", "title": "You can apply for a promotion: write your reflection", "module": "jobs", "building": "job", "priority": 2,
    "when": [{ "fact": "jobs.promotionEligible", "op": "==", "value": true }],
    "done": { "facts": [{ "fact": "jobs.applicationPending", "op": "==", "value": true }] }, "reward_cents": 150, "energy": 1 },

  { "id": "move-to-hisa", "title": "Move idle chequing money into your HISA", "module": "savings", "building": "networth", "priority": 3,
    "when": [{ "fact": "savings.idleChequingCents", "op": ">=", "value": 100000 }],
    "done": { "event": "ledger.posted", "kind": "savings.move", "into": "hisa" }, "reward_cents": 100, "energy": 1 },
  { "id": "buy-gic", "title": "Lock part of your savings in a GIC", "module": "savings", "building": "networth", "priority": 4,
    "when": [{ "fact": "savings.hisaCents", "op": ">=", "value": 100000 }, { "fact": "savings.gicCount", "op": "==", "value": 0 }],
    "done": { "facts": [{ "fact": "savings.gicCount", "op": ">", "value": 0 }] }, "reward_cents": 100, "energy": 1 },
  { "id": "open-tfsa", "title": "Put some money in a TFSA", "module": "exchange", "building": "exchange", "priority": 4,
    "when": [{ "fact": "exchange.tfsaContributedCents", "op": "==", "value": 0 }, { "fact": "savings.idleChequingCents", "op": ">=", "value": 50000 }],
    "done": { "event": "ledger.posted", "kind": "exchange.contribute", "into": "tfsa" }, "reward_cents": 100, "energy": 1 },
  { "id": "first-investment", "title": "Buy your first fund or share", "module": "exchange", "building": "exchange", "priority": 5,
    "when": [{ "fact": "exchange.holdings", "op": "==", "value": 0 }, { "fact": "savings.idleChequingCents", "op": ">=", "value": 50000 }],
    "done": { "facts": [{ "fact": "exchange.holdings", "op": ">", "value": 0 }] }, "reward_cents": 100, "energy": 1 },
  { "id": "apply-card", "title": "Apply for your first credit card", "module": "credit", "building": "credit", "priority": 5,
    "when": [{ "fact": "credit.hasCard", "op": "==", "value": false }, { "fact": "credit.inquiries", "op": "==", "value": 0 }, { "fact": "jobs.hasJob", "op": "==", "value": true }],
    "done": { "facts": [{ "fact": "credit.inquiries", "op": ">", "value": 0 }] }, "reward_cents": 100, "energy": 1 },

  { "id": "tour-paystub", "title": "Read your pay stub and find the CPP line", "module": "jobs", "building": "job", "priority": 6,
    "when": [{ "fact": "jobs.hasJob", "op": "==", "value": true }],
    "done": { "visit": "job" }, "reward_cents": 50, "energy": 1 },
  { "id": "tour-bank-of-daa", "title": "Open the Bank of DAA and find the policy rate", "module": "rates", "building": "bank-of-daa", "priority": 7,
    "when": [], "done": { "visit": "bank-of-daa" }, "reward_cents": 50, "energy": 1 },
  { "id": "tour-networth", "title": "Check your net worth and what is in it", "module": "savings", "building": "networth", "priority": 7,
    "when": [], "done": { "visit": "networth" }, "reward_cents": 50, "energy": 1 },
  { "id": "tour-mortgage", "title": "See whether you could qualify for a mortgage", "module": "housing", "building": "housing", "priority": 7,
    "when": [{ "fact": "housing.owns", "op": "==", "value": false }, { "fact": "jobs.hasJob", "op": "==", "value": true }],
    "done": { "visit": "housing" }, "reward_cents": 50, "energy": 1 },
  { "id": "tour-budget", "title": "Compare your budget with the 50/30/20 targets", "module": "bills", "building": "bills", "priority": 8,
    "when": [], "done": { "visit": "bills" }, "reward_cents": 50, "energy": 1 },
  { "id": "tour-credit", "title": "Look up your credit score and what moves it", "module": "credit", "building": "credit", "priority": 8,
    "when": [{ "fact": "credit.hasCard", "op": "==", "value": true }],
    "done": { "visit": "credit" }, "reward_cents": 50, "energy": 1 },
  { "id": "tour-insurance", "title": "Check what your insurance covers", "module": "insurance", "building": "insurance", "priority": 8,
    "when": [], "done": { "visit": "insurance" }, "reward_cents": 50, "energy": 1 },
  { "id": "tour-amphitheatre", "title": "See your Wolf rank at the Amphitheatre", "module": "leaderboards", "building": "amphitheatre", "priority": 8,
    "when": [], "done": { "visit": "amphitheatre" }, "reward_cents": 50, "energy": 1 },

  { "id": "learn-level", "title": "Finish a level on the Learning Road", "module": "learn", "building": "learn", "priority": 6,
    "when": [{ "fact": "learn.hasOpenLevel", "op": "==", "value": true }], "done": { "event": "module.learn.completed" }, "reward_cents": 50, "energy": 1 },

  { "id": "play-bill-dash", "title": "Play a round of Bill Dash", "module": "arcade", "building": "arcade", "priority": 6,
    "when": [{ "fact": "arcade.billdashOn", "op": "==", "value": true }], "done": { "event": "module.arcade.played" }, "reward_cents": 50, "energy": 1 },
  { "id": "play-diversify", "title": "Play a round of Diversify", "module": "arcade", "building": "arcade", "priority": 6,
    "when": [{ "fact": "arcade.diversifyOn", "op": "==", "value": true }], "done": { "event": "module.arcade.played_diversify" }, "reward_cents": 50, "energy": 1 },
  { "id": "play-debt-snake", "title": "Play a round of Debt Snake", "module": "arcade", "building": "arcade", "priority": 6,
    "when": [{ "fact": "arcade.debtsnakeOn", "op": "==", "value": true }], "done": { "event": "module.arcade.played_debtsnake" }, "reward_cents": 50, "energy": 1 },
  { "id": "play-finword", "title": "Play today's FinWord", "module": "arcade", "building": "arcade", "priority": 6,
    "when": [{ "fact": "arcade.finwordOn", "op": "==", "value": true }], "done": { "event": "module.arcade.played_finword" }, "reward_cents": 50, "energy": 1 },
  { "id": "walk-stroll", "title": "Take a stroll through town and collect 3 items", "module": "walk", "building": "walk", "priority": 5,
    "when": [], "done": { "event": "module.walk.collected" }, "reward_cents": 50, "energy": 1 },

  { "id": "set-retire-age", "title": "Set your retirement age", "module": "life", "building": "life", "priority": 2,
    "when": [{ "fact": "life.stage", "op": ">=", "value": 2 }, { "fact": "life.retireSet", "op": "==", "value": false }, { "fact": "life.yearsToRetire", "op": ">", "value": 0 }],
    "done": { "facts": [{ "fact": "life.retireSet", "op": "==", "value": true }] }, "reward_cents": 100, "energy": 1 },
  { "id": "set-cpp-age", "title": "Set your CPP start age", "module": "retirement", "building": "retirement", "priority": 2,
    "when": [{ "fact": "life.stage", "op": ">=", "value": 3 }, { "fact": "retirement.cppSet", "op": "==", "value": false }, { "fact": "retirement.cppOpen", "op": "==", "value": true }],
    "done": { "facts": [{ "fact": "retirement.cppSet", "op": "==", "value": true }] }, "reward_cents": 100, "energy": 1 },
  { "id": "review-retirement", "title": "Review your retirement income", "module": "retirement", "building": "retirement", "priority": 3,
    "when": [{ "fact": "life.stage", "op": ">=", "value": 3 }],
    "done": { "visit": "retirement" }, "reward_cents": 50, "energy": 1 }
]
